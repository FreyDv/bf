{
  "name": "bf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=11.28.10"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write apps packages package.json turbo.json .dependency-cruiser.mjs scripts/boundaries.test.ts",
    "format:check": "prettier --check apps packages package.json turbo.json .dependency-cruiser.mjs scripts/boundaries.test.ts",
    "deps": "depcruise apps packages --config .dependency-cruiser.mjs",
    "deps:test": "node --test scripts/boundaries.test.ts",
    "local:up": "docker compose up -d --wait",
    "local:cdc": "docker compose --profile cdc up -d --wait",
    "local:down": "docker compose --profile cdc down",
    "local:reset": "docker compose --profile cdc down -v"
  },
  "prettier": "@bf/config/prettier",
  "devDependencies": {
    "@bf/config": "workspace:*",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$about": [
    "Agent settings baseline from repository-standards (standard.manifest.json entry .claude/settings.json, merge-class, R19),",
    "merged with this repo's own entries. Deliberate adaptations, each one recorded in docs/adoption-intake.md:",
    "1. Read(**/.env.*) narrowed to the secret-bearing variants so that the committed .env.example files stay readable",
    "   (pnpm setup:env and pnpm env:check depend on them).",
    "2. REMOTE_DB_ENV_FILES names this monorepo's per-app env files so the remote-database guard resolves the host a",
    "   migration runner would use (apps/<svc>/.env, never a root .env).",
    "3. ask: this repo's own deploy, release and database scripts under infra/aws/scripts and scripts/ci.",
    "4. onFailure: block on both PreToolUse hooks - Claude Code lets a crashing or timed-out hook fail OPEN by",
    "   default (docs: hooks, 'onFailure'); the shipped || fallback covers a missing script, this covers the rest."
  ],
  "env": {
    "REMOTE_DB_ENV_FILES": "apps/auth/.env apps/order/.env apps/course/.env apps/billing/.env apps/admin/.env apps/ai/.env apps/api/.env infra/postgres/.env"
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -rF *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(diskutil erase*)",
      "Bash(diskutil partition*)",
      "Bash(shred *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(halt *)",
      "Bash(killall *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(npm publish *)",
      "Bash(npm publish)",
      "Bash(pnpm publish *)",
      "Bash(pnpm publish)",
      "Bash(pg_restore *)",
      "Bash(prisma migrate *)",
      "Bash(prisma db push *)",
      "Bash(npx prisma migrate *)",
      "Bash(npx prisma db push *)",
      "Bash(drizzle-kit *)",
      "Bash(npx drizzle-kit *)",
      "Bash(knex migrate*)",
      "Bash(npx knex migrate*)",
      "Bash(node-pg-migrate *)",
      "Bash(npx node-pg-migrate *)",
      "Bash(typeorm migration*)",
      "Bash(npx typeorm migration*)",
      "Bash(kysely migrate*)",
      "Bash(npx kysely migrate*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production*)",
      "Read(**/.env.prod*)",
      "Read(**/.env.staging*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(docker system prune)",
      "Bash(fly deploy *)",
      "Bash(fly deploy)",
      "Bash(flyctl deploy *)",
      "Bash(fly secrets set *)",
      "Bash(fly secrets unset *)",
      "Bash(fly ssh console *)",
      "Bash(flyctl ssh console *)",
      "Bash(cdk deploy *)",
      "Bash(cdk destroy *)",
      "Bash(npx cdk deploy *)",
      "Bash(npx cdk destroy *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws ecs update-service *)",
      "Bash(psql *)",
      "Bash(psql)",
      "Bash(pgcli *)",
      "Bash(pg_dump *)",
      "Bash(pg_dumpall *)",
      "Bash(fly postgres *)",
      "Bash(flyctl postgres *)",
      "Bash(fly pg *)",
      "Bash(flyctl pg *)",
      "Bash(fly mpg *)",
      "Bash(flyctl mpg *)",
      "Bash(fly proxy *)",
      "Bash(flyctl proxy *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(brew uninstall *)",
      "Bash(launchctl *)",
      "Bash(crontab *)",
      "Bash(pnpm aws:deploy*)",
      "Bash(pnpm aws:release*)",
      "Bash(pnpm aws:static*)",
      "Bash(pnpm aws:exec*)",
      "Bash(pnpm db:rotate-password*)",
      "Bash(pnpm db:allow-me*)",
      "Bash(pnpm repo:settings*)",
      "Bash(pnpm --filter @bf/infra-aws run deploy*)",
      "Bash(node infra/aws/scripts/release.ts*)",
      "Bash(node infra/aws/scripts/static-deploy.ts*)",
      "Bash(node infra/aws/scripts/exec.ts*)",
      "Bash(node infra/aws/scripts/db-rotate-password.ts*)",
      "Bash(node infra/aws/scripts/db-allow-me.ts*)",
      "Bash(node scripts/ci/repo-settings.ts --apply*)",
      "Bash(gh workflow run *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/guards.sh || printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Blocked by repository policy: the agent guards could not be run (.claude/hooks/guards.sh was not found or is not executable), so this command was never checked.\"}}'",
            "statusMessage": "Checking agent guards",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/elicitation-guard.mjs || printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Blocked by repository policy: the elicitation guard could not be run (.claude/hooks/elicitation-guard.mjs was not found, or node is missing), so nothing checked whether this artifact was ever asked about.\"}}'",
            "statusMessage": "Checking the artifact was asked about",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

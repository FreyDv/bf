NODE_ENV=development
PORT=3001
SERVICE_NAME=auth
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
REQUEST_TIMEOUT_MS=30000
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
# RS256 key pair, base64(PEM). DEV-ONLY — the same pair sits in every .env.example; regenerate with `pnpm gen:jwt-keys`.
JWT_PUBLIC_
JWT_PRIVATE_
JWT_EXPIRES_IN=15m
JWT_ISSUER=bf-auth
REFRESH_TOKEN_TTL_DAYS=30

# Postgres: own database "auth" (created by infra/postgres/postgres-init/01-init.sql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auth
POSTGRES_USER=bf
POSTGRES_PASSWORD=bf
POSTGRES_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECT_TIMEOUT_MS=5000

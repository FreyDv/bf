NODE_ENV=development
PORT=3000
SERVICE_NAME=api
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
REQUEST_TIMEOUT_MS=30000
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
# RS256 public key, base64(PEM). DEV-ONLY pair shared by every .env.example — regenerate with `pnpm gen:jwt-keys`.
JWT_PUBLIC_
JWT_EXPIRES_IN=15m
JWT_ISSUER=bf-auth

# Route table: /<name>/* → <url>/*
UPSTREAMS=auth=http://localhost:3001,order=http://localhost:3002,course=http://localhost:3003,billing=http://localhost:3004,admin=http://localhost:3005,ai=http://localhost:3006
# Path prefixes that bypass JWT at the edge (as the browser sees them). /<svc>/health is always public.
PUBLIC_PATHS=/auth/api/auth/
# Extra role required per service prefix
ROUTE_ROLES=admin=admin
# Edge rate limit per identity (or IP when anonymous)
EDGE_RATE_LIMIT=600
EDGE_RATE_TTL_MS=60000

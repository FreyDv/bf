NODE_ENV=development
PORT=3006
SERVICE_NAME=ai
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3006
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
REQUEST_TIMEOUT_MS=30000
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
# RS256 public key, base64(PEM). DEV-ONLY pair shared by every .env.example — regenerate with `pnpm gen:jwt-keys`.
JWT_PUBLIC_
JWT_EXPIRES_IN=15m
JWT_ISSUER=bf-auth

# OpenAI (optional; ai.ask returns PRECONDITION_FAILED when the key is absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

{
  "name": "ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.cjs --runInBand",
    "contracts:generate": "node ../../scripts/trpc-generate.mjs ai"
  },
  "dependencies": {
    "@bf/contracts": "workspace:*",
    "@bf/server": "workspace:*",
    "@bf/shared": "workspace:*",
    "@bf/trpc": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@trpc/server": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "nestjs-trpc": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:",
    "@bf/llm": "workspace:*"
  },
  "devDependencies": {
    "@bf/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

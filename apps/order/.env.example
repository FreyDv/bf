NODE_ENV=development
PORT=3002
SERVICE_NAME=order
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
REQUEST_TIMEOUT_MS=30000
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
# RS256 public key, base64(PEM). DEV-ONLY pair shared by every .env.example — regenerate with `pnpm gen:jwt-keys`.
JWT_PUBLIC_
JWT_EXPIRES_IN=15m
JWT_ISSUER=bf-auth

# Upstream services (tRPC clients)
AUTH_URL=http://localhost:3001

# Postgres: own database "order" (created by infra/postgres/postgres-init/01-init.sql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=order
POSTGRES_USER=bf
POSTGRES_PASSWORD=bf
POSTGRES_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECT_TIMEOUT_MS=5000

# Object storage: S3_ENDPOINT set => MinIO (local). Unset on AWS (task role credentials).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=bfadmin
S3_SECRET_ACCESS_KEY=bfbfbfbf
S3_BUCKET=bf-order
S3_PRESIGN_TTL=900

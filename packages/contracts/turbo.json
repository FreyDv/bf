    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/backend/src/**/*.request.dto.ts",
        "$TURBO_ROOT$/apps/backend/src/**/*.response.dto.ts",
        "$TURBO_ROOT$/apps/backend/src/**/*.enum.ts",
        "$TURBO_ROOT$/apps/backend/src/**/*.filter-spec.ts"
      ]
    }
  }
}

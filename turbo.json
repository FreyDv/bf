{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "lint:fix": { "dependsOn": ["^build"], "cache": false },
    "format": { "cache": false },
    "format:check": {},
    "deps": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["POSTGRES_*", "REDIS_*", "S3_*"]
    },
    "contracts:generate": { "dependsOn": ["^build"], "cache": false, "outputs": [] },
    "db:generate": { "dependsOn": ["^build"], "cache": false },
    "db:check": { "dependsOn": ["^build"] },
    "db:migrate": { "dependsOn": ["^build"], "cache": false, "env": ["POSTGRES_*"] },
    "db:seed": { "dependsOn": ["^build", "db:migrate"], "cache": false, "env": ["POSTGRES_*"] },
    "dev": { "dependsOn": ["^build"], "persistent": true, "cache": false }
  }
}

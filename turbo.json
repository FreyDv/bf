{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalDependencies": ["pnpm-lock.yaml", "pnpm-workspace.yaml", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "NATS_URL"]
    },
    "secrets:seal": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}

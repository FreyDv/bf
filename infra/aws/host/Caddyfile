# Public entry of the machine: the ONLY container with published ports (80/443).
# Caddy obtains and renews the Let's Encrypt certificates itself (HTTP-01 on :80) and redirects http → https.
# Domains come from the host's .env (rendered by the bf-prod stack, see lib/host.ts).
#
# No active health checks on purpose: /health/ready runs `select 1`, which would keep Aurora from pausing.

{$MAIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy fe-main:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3000
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy fe-admin:3000
}

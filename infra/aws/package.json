{
  "name": "@bf/infra-aws",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AWS infrastructure (CDK: ECS Fargate + ALB + CloudFront/S3 + Aurora) and operational scripts (AWS SDK v3)",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff bf-prod bf-prod-apps",
    "deploy": "cdk deploy bf-prod bf-prod-apps --require-approval never",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy:apps": "cdk deploy bf-prod-apps --require-approval never",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "catalog:",
    "@aws-sdk/client-cloudformation": "^3.864.0",
    "@aws-sdk/client-cloudfront": "^3.864.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.864.0",
    "@aws-sdk/client-ec2": "^3.864.0",
    "@aws-sdk/client-ecr": "^3.864.0",
    "@aws-sdk/client-ecs": "catalog:",
    "@aws-sdk/client-kms": "^3.864.0",
    "@aws-sdk/client-rds": "^3.864.0",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-secrets-manager": "^3.864.0",
    "@aws-sdk/client-ssm": "^3.864.0",
    "@aws-sdk/client-sts": "^3.864.0",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@bf/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}

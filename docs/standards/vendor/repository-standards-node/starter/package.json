{
  "name": "starter",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.1.2"
  },
  "scripts": {
    "dev": "pnpm db:init && turbo run dev",
    "db:init": "pnpm --filter @starter/auth db:init",
    "build": "turbo run build",
    "check:all": "turbo run check:format check:types check:lint && pnpm check:format:styles",
    "check:types": "turbo run check:types",
    "check:lint": "turbo run check:lint",
    "check:format": "turbo run check:format",
    "format": "biome format --write . && pnpm format:styles",
    "format:styles": "prettier --write \"**/*.scss\"",
    "check:format:styles": "prettier --check \"**/*.scss\"",
    "lint": "biome check .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:perf": "bash scripts/perf-budget.sh",
    "test:perf:update": "bash scripts/perf-budget.sh --update",
    "test:perf:remote": "pnpm --filter perf exec node run-perf.mjs && pnpm --filter perf exec node compare.mjs",
    "test:perf:remote:update": "pnpm --filter perf exec node run-perf.mjs && pnpm --filter perf exec node compare.mjs --update",
    "bootstrap:test-stack": "docker compose -f docker-compose.test.yml up -d --wait",
    "teardown:test-stack": "docker compose -f docker-compose.test.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@vitest/coverage-v8": "3.2.4",
    "prettier": "3.8.5",
    "turbo": "2.10.0",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}
